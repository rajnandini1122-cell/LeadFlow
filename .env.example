#
# Copy to apps/api/.env and fill in real values.
# NEVER commit a real .env. NEVER reuse credentials across environments.
# =============================================================================

# -----------------------------------------------------------------------------
# Product identity
#
# Kept in configuration so one build can be rebranded per deployment.
# -----------------------------------------------------------------------------
PRODUCT_NAME=LeadFlow
PRODUCT_TAGLINE=Simple lead management and follow-up for growing teams
PRODUCT_LOGO_URL=

# -----------------------------------------------------------------------------
# Email
#
# console  development only. Logs the message instead of sending it, so a fresh
#          checkout has a working password-reset and invitation flow with no
#          signup and no API key. REFUSED in production: a deployment with no
#          mail configured would look healthy while every reset silently went
#          nowhere, and live tokens would land in log aggregation.
#
# smtp     production. Any standards-compliant SMTP server — a hosting
#          mailbox, a corporate relay, a transactional provider's SMTP
#          endpoint. Requires the SMTP_* block below, ALL of it: the process
#          refuses to start on a partial configuration, because a transport
#          missing a password accepts every message and delivers none.
#
# To add another transport, implement EmailProvider in
# apps/api/src/common/email/providers/ and register it in createEmailProvider.
# No auth or invitation code changes.
# -----------------------------------------------------------------------------
# console  development only. Logs instead of sending; REFUSED in production.
# smtp     any standards-compliant SMTP server. Requires the SMTP_* block.
# resend   Resend's HTTPS API. Requires RESEND_API_KEY only.
#
# Use `resend` on Railway. Railway blocks outbound SMTP — connections time out
# before authentication, so no SMTP credential can fix it; the network path is
# the problem. An HTTPS API is reachable from the same host.
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=resend, ignored otherwise. Never commit a real
# key: set it in the platform secret store.
RESEND_API_KEY=

# The envelope sender. A bare address, or a display name with one.
# Must be a mailbox the SMTP server is allowed to send as — most servers reject
# a From they do not own, and the mail then silently never arrives.
EMAIL_FROM=LeadFlow <no-reply@example.com>

# --- SMTP (required when EMAIL_PROVIDER=smtp) --------------------------------
#
# PLACEHOLDERS. Real credentials belong in the deployment's secret store and
# never in a file that is committed.
#
# SMTP_SECURE says how TLS starts, and is deliberately NOT inferred from the
# port. It must be exactly 'true' or 'false' — SMTP_SECURE=1 is refused rather
# than quietly read as one mode or the other:
#
#   true   implicit TLS from the first byte, conventionally port 465
#   false  plaintext connection upgraded with STARTTLS, conventionally 587.
#          The upgrade is REQUIRED, not attempted: a server that does not
#          offer STARTTLS is an error, so the password is never sent in the
#          clear. Certificate validation is never disabled.
#
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-with-the-mailbox-password

# Where emailed links point — the WEB app, not the API.
WEB_BASE_URL=http://localhost:5173
# Where public contact-form enquiries are delivered.
SALES_EMAIL=sales@cravionventures.com

# -----------------------------------------------------------------------------
# Defaults for NEWLY created organizations
#
# Fallbacks only, and only at creation. Each organization stores its own four
# values and every tenant-visible figure is formatted from THOSE — changing a
# setting here reaches no existing tenant, which is what makes it safe to
# change.
#
# India, because that is the market this deployment opens in. All four are
# validated at boot against the runtime's own ICU data, so a typo stops the
# process rather than creating tenants whose settings screen would refuse the
# values they were given.
#
# DEFAULT_COUNTRY is the one with teeth: it decides how a local phone number
# typed by that tenant is read into E.164 (9876543210 -> +919876543210), and
# duplicate detection compares the canonical form.
#
# Timezones are IANA identifiers, spelled exactly — "Asia/Kolkata", not "IST",
# which ICU would accept and resolve to somewhere else entirely.
# -----------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_COUNTRY=IN

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Neon in development)
#
# DATABASE_URL        -> POOLED endpoint. Used by the running application.
# DIRECT_DATABASE_URL -> UNPOOLED endpoint. Used by Prisma Migrate only.
#
# Migrations take advisory locks and run DDL, which fails against a
# transaction-mode pooler. These two MUST be different on Neon.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.<region>.aws.neon.tech/idea001?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.<region>.aws.neon.tech/idea001?sslmode=require

# Connections per process. Ten is the production starting point, per API
# replica and for the worker. Saturation appears in database.query_failures on
# /api/metrics before it appears as latency.
#
# The e2e suite overrides this: PGlite serves ONE connection, so a pool of more
# than one would deadlock it, while the real-PostgreSQL run on CI uses ten so
# the concurrency suites actually contend. See apps/api/test/global-setup.ts.
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis (Upstash in development)
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# -----------------------------------------------------------------------------
# Auth
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Must differ per environment AND between the
# two secrets.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# How long after a refresh token is rotated a second presentation of it is
# still treated as a straggler from the same wave rather than a leak.
# Suppresses family revocation only: the spent token still fails with 401 and
# still mints nothing. 0 disables the tolerance; the maximum is 10000.
REFRESH_REUSE_INTERVAL_MS=2000

# argon2id tuning (OWASP baseline: 19 MiB, t=2, p=1)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging — Phase 8, optional until then
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# WhatsApp — Phase 10, optional until then
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
# From the Meta app dashboard. Every webhook body is signed with it.
WHATSAPP_APP_SECRET=
# Any long random string. You paste the SAME value into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Graph API version. Bump when Meta deprecates one; nothing else changes.
WHATSAPP_API_VERSION=v21.0

# Instagram Direct Messages. Separate values because the Instagram product may
# live in a different Meta app; set the same values if it shares one.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Facebook Messenger. Separate again — set the same values if all three
# products share one Meta app.
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=

# Stale outbound message recovery. A message still PENDING after this many
# seconds belongs to a process that died mid-send; it is finalised as
# UNCONFIRMED and never automatically resent.
OUTBOUND_RECOVERY_ENABLED=true
OUTBOUND_RECOVERY_AFTER_SECONDS=120
OUTBOUND_RECOVERY_INTERVAL_SECONDS=60

# Encrypts provider access tokens at rest. Generate with:
#   openssl rand -base64 32
# Losing this makes stored credentials unreadable — they must be re-entered.
CREDENTIAL_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Process role
#
# The API and the worker are the SAME image. This flag is what decides which
# one a container is, so it must be set explicitly on both services.
#
#   false  API. Serves HTTP, runs no background processors.
#   true   Worker. Runs the follow-up sweep, the intake sweep and the queues,
#          and binds no HTTP port at all.
#
# It defaults to false because both roles ship from one build: without an
# explicit flag every API replica would also sweep, so three replicas would
# mean three concurrent sweeps competing with request latency — the exact thing
# a separate worker process exists to prevent.
#
# EXACTLY ONE worker replica. The sweep is safe to run concurrently, but a
# second replica would only do the same work twice.
#
# A production worker also requires the FIREBASE_* block above: a process whose
# entire job is reaching salespeople, deployed with no way to reach them, is
# refused at boot rather than left looking healthy. An API replica does not
# need those credentials and should not be given them.
# -----------------------------------------------------------------------------
WORKER_ENABLED=false

# -----------------------------------------------------------------------------
# Release identity
#
# The git SHA of the running build, used to group errors by deploy.
#
# MANDATORY IN PRODUCTION — the process refuses to start without it. Every
# deploy would otherwise group as one deploy in the error tracker, making
# today's regression indistinguishable from three-month-old noise, and the
# refusal is deliberate: an unset value here is only discovered during the
# incident it would have helped diagnose.
#
# Leave it empty in development. Set it from the build, e.g.
#   RELEASE_SHA=$(git rev-parse HEAD)
# -----------------------------------------------------------------------------
RELEASE_SHA=

# -----------------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------------
# The general API limit, applied to every route.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# The credential limit: login, registration, Google sign-in, password reset
# and password change. It reaches ONLY those endpoints — never ordinary CRM
# traffic, the refresh endpoint or provider webhooks.
AUTH_THROTTLE_TTL=900
AUTH_THROTTLE_LIMIT=5

# How many reverse proxies sit in front of the API.
#
# req.ip is what every rate limit and audit row is keyed on, and Express
# derives it by walking X-Forwarded-For from the right through this many hops.
# 0 trusts nothing and is the safe default: with a higher value than the real
# topology, any caller can mint a fresh identity per request by sending the
# header. Set it to the real number once the deployment is fixed — typically 1
# behind a single load balancer, 2 behind a CDN in front of one.
TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Website intake integration (server-to-server)
#
# The boundary the CRAVION website submits enquiries through. OFF unless
# deliberately switched on: while disabled the route answers 404 rather than
# advertising an endpoint nobody has configured.
#
# It is NOT a browser endpoint. The caller is an approved backend that proves
# itself by signing each request — HMAC-SHA256 over the timestamp, the event id
# and the exact body bytes — and CORS, Origin, Referer and source IP play no
# part in deciding whether a request is genuine.
#
# WEBSITE_INTAKE_ORGANIZATION_ID is the tenant every submission lands in. It is
# configuration and never a field in the request: a signature proves who is
# calling, not which tenant they may write into, so a caller that could name
# one would turn a single shared secret into access to all of them.
#
# Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Both values are required when the integration is enabled; the process refuses
# to start otherwise. The secret is never logged and never returned by any API.
# -----------------------------------------------------------------------------
WEBSITE_INTAKE_ENABLED=false
WEBSITE_INTAKE_ORGANIZATION_ID=
WEBSITE_INTAKE_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Automatic intake -> lead conversion
#
# Whether the worker turns stored website enquiries into leads by itself:
# routing each one to a team, assigning a salesperson round-robin and creating
# the first follow-up.
#
# OFF, and this default matters more than most. The intake table is durable and
# may hold a backlog of enquiries that arrived before this code existed. A
# deploy that switched processing on by itself would convert all of them at
# once, assign them to real salespeople and create a follow-up for each — very
# easy to do and very hard to undo.
#
# So turning it on is a deliberate act, separate from shipping the code that
# can do it: deploy with false, confirm enquiries are landing in
# integration_intakes, review the backlog, then set true and redeploy.
#
# Requires WORKER_ENABLED=true to have any effect — the conversion runs in the
# worker, never in an API replica.
# -----------------------------------------------------------------------------
INTAKE_AUTO_PROCESSING_ENABLED=false

# -----------------------------------------------------------------------------
# Central Admin control plane (off by default)
#
# A server-to-server boundary that lets the CRAVION Central Admin application
# administer one tenant's sales teams, assignment rules, territories and website
# enquiry queue — without direct database access, without a LeadFlow user's
# password, and without copying CRM state anywhere else.
#
# A SEPARATE TRUST DOMAIN from the website intake above, and it must stay that
# way: the website secret is held by a public-facing site, while this one can
# rewrite a tenant's routing. Sharing a key would make a compromise of either a
# compromise of both, and neither could be rotated alone. The process refuses to
# start if the two are equal.
#
# Requests are signed HMAC-SHA256 over the method, the path, the timestamp, the
# request id, the external actor reference and the exact body bytes. The method
# and path are included so a captured command cannot be replayed at a different
# endpoint. CORS, Origin, Referer and source IP play no part in deciding whether
# a request is genuine.
#
# ADMIN_CONTROL_ORGANIZATION_ID is the one tenant this control plane
# administers. Configuration, never a field in the request.
#
# Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Both values are required when the control plane is enabled. The secret is
# never logged and never returned by any endpoint.
# -----------------------------------------------------------------------------
ADMIN_CONTROL_ENABLED=false
ADMIN_CONTROL_ORGANIZATION_ID=
ADMIN_CONTROL_SIGNING_SECRET=
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# --- platform operations ------------------------------------------------------
# Contact number for the PLATFORM operator (you), not for any tenant.
# Read in exactly one place — PlatformService — and used only for operational
# alerting and future support/recovery tooling. It grants no permission and
# plays no part in authentication or tenant isolation.
# E.164 format. Leave blank to disable operator alerting.
# Placeholder. Set the real operator number in the deployment environment,
# never in a file that is committed.
PLATFORM_MASTER_PHONE=+10000000000

# ---------------------------------------------------------------------------
# Google sign-in (optional)
#
# Leave blank and "Continue with Google" simply does not appear — the client
# hides the button rather than showing one that fails on click.
#
# Create at console.cloud.google.com:
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   Application type: Web application
#   Authorised JavaScript origins: your web app's origin, e.g.
#     http://localhost:5173  (and 5174 if Vite has moved)
#
# The client ID is PUBLIC by design — it is embedded in every browser that
# renders the button. This flow verifies an ID token Google issued to the
# browser, so there is deliberately NO client secret.
GOOGLE_CLIENT_ID=
