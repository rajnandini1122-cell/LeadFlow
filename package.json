{
  "name": "leadflow",
  "version": "0.1.0",
  "private": true,
  "description": "LeadFlow — simple lead management and follow-up for growing teams",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/api-types",
    "packages/shared-config"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:local": "node scripts/local-db.mjs --port 5433",
    "db:migrate:deploy": "npm run db:migrate:deploy -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run start:worker -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:bootstrap": "npm run db:bootstrap -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "android:sync": "npm run android:sync -w apps/web",
    "android:open": "npm run android:open -w apps/web",
    "android:build": "npm run android:build -w apps/web",
    "android:publish": "node scripts/publish-apk.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
